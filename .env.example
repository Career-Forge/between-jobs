# ═══════════════════════════════════════════════════════════════
# Between Jobs -- Environment Variables
# Copy to .env and fill in your values: cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# --- REQUIRED: Supabase ---
# Project URL: dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key: dashboard -> Project Settings -> API -> service_role
# secret. NEVER the anon/publishable key -- this backend is a trusted
# server (the only thing that talks to Postgres directly; channels hit
# this API, never Supabase itself), so it needs to bypass RLS the way a
# real backend does. Deliberately not retrievable via any AI tool call --
# copy it from the dashboard yourself.
SUPABASE_SERVICE_ROLE_KEY=

# --- REQUIRED: Telegram bridge ---
# A SEPARATE bot from the n8n bot -- n8n is reference-only now and must
# keep running untouched. Message @BotFather -> /newbot -> follow prompts.
TELEGRAM_BOT_TOKEN=

# Shared secret Telegram echoes back on every webhook call so this app can
# tell a real Telegram update from a forged POST to the same URL. Generate
# with: openssl rand -hex 32
# Register it with Telegram once you have a public HTTPS URL (e.g. via
# ngrok for local dev):
#   curl "https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook" \
#     -d "url=<your-public-url>/telegram/webhook" \
#     -d "secret_token=<this value>"
TELEGRAM_WEBHOOK_SECRET=

# --- OPTIONAL: Gmail draft integration (outreach-contactfinder.md
# Phase F) ---
# Not needed to boot the app at all -- only the Gmail-connect/callback/
# push-to-Gmail routes read these, lazily, at request time. Leaving them
# unset means those specific routes cleanly return SETUP_REQUIRED rather
# than working, everything else in the app is unaffected.
# Google Cloud Console -> APIs & services -> Credentials -> OAuth 2.0
# Client ID (type: Web application) -- enable the plain "Gmail API"
# there, NOT "Gmail MCP API" (Developer Preview, wrong shape for a fixed
# backend action -- see the plan's own Phase F research). Scope used is
# gmail.compose only, never gmail.send or gmail.modify -- this backend
# can create a draft and nothing else, structurally, not just by
# convention. Both values deliberately not retrievable via any AI tool
# call -- copy them from the Google Cloud Console dashboard yourself,
# same reasoning as SUPABASE_SERVICE_ROLE_KEY above.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Must exactly match one of the "Authorized redirect URIs" you register
# on that same OAuth Client ID. Local dev default matches
# .claude/launch.json's own "spine" port (8012) -- change only for a
# non-local deployment.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8012/oauth/gmail/callback

# --- OPTIONAL: forge-engines (Sprint 3.0d) ---
# Base URL of the private forge-engines service (its own Dockerfile exposes
# :5682). Defaults to http://localhost:5682 if unset -- only needs setting
# for a non-local deployment. No credential goes here: forge-engines takes
# a BYOK secret per call, resolved via this platform's own
# CredentialResolver (Sprint 2.7e), never a platform-wide env var.
FORGE_ENGINES_BASE_URL=http://localhost:5682

# --- OPTIONAL: n8n job registry seed source (Job Finder P1, one-time) ---
# A direct Postgres connection string (asyncpg DSN, e.g.
# postgresql://user:pass@host:port/dbname) to the separate, live n8n
# instance's own database -- a system this platform reads but never owns
# and never writes to (discovery_store.py opens every query inside a real
# `START TRANSACTION READ ONLY`). NOT read by the live app at all (Job
# Finder P8 replaced the old discovery-facade routes that used to depend
# on it with this platform's own independent search pipeline) -- only
# used, one-time and standalone, by scripts/import_job_registry_seed.py
# to bootstrap between-jobs' own job_registry_companies/job_registry_
# postings tables from n8n's already-seeded data.
N8N_JOBS_DATABASE_URL=

# --- OPTIONAL: logging ---
# One JSON object per line on stdout. DEBUG, INFO (default), WARNING or ERROR;
# anything else falls back to INFO. It sets this app's own loggers only:
# third-party libraries (httpx, openai, ...) always log at WARNING and above,
# because their lower levels print URLs, headers and prompts. Logs carry ids,
# counts, error codes and exception types -- never request bodies, keys,
# resume/JD text or email -- and exceptions are logged without their messages.
LOG_LEVEL=INFO

# --- OPTIONAL: background workers ---
# Each worker runs unless its DISABLE_* variable is set to ANY non-empty value.
# The check is "is it set", not "is it true": DISABLE_OUTBOX_WORKER=false and
# DISABLE_OUTBOX_WORKER=0 both disable the worker. Leave a line out (or empty)
# to keep that worker running. The test suite sets all five.
# DISABLE_OUTBOX_WORKER=
# DISABLE_JOB_REGISTRY_POLLER=
# DISABLE_SAVED_SEARCH_MATCHER=
# DISABLE_GMAIL_REPLY_CHECKER=
# DISABLE_HIRING_SIGNAL_CACHE_PURGE=
