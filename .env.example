# ═══════════════════════════════════════════════════════════════
# Between Jobs -- Environment Variables
# Copy to .env and fill in your values: cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# --- REQUIRED: Supabase ---
# Project URL: dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key: dashboard -> Project Settings -> API -> service_role
# secret. NEVER the anon/publishable key -- this backend is a trusted
# server (the only thing that talks to Postgres directly; channels hit
# this API, never Supabase itself), so it needs to bypass RLS the way a
# real backend does. Deliberately not retrievable via any AI tool call --
# copy it from the dashboard yourself.
SUPABASE_SERVICE_ROLE_KEY=
