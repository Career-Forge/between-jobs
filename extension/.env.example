# Copy to .env.local and fill in real values -- never commit .env.local.
#
# Same Supabase project the web frontend (../web/.env.example) points at --
# the extension gets its own independent auth session (browser-extension.md
# D2's storage rules assume a self-owned session), not a shared login, but
# it's the same project/schema.
WXT_SUPABASE_URL=
WXT_SUPABASE_PUBLISHABLE_KEY=

# The between-jobs FastAPI backend this extension calls -- local dev
# default matches .claude/launch.json's own port (8012).
WXT_API_BASE_URL=http://localhost:8012
