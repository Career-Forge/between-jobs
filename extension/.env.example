# Copy to .env.local and fill in real values -- never commit .env.local.
#
# Same Supabase project the web frontend (../web/.env.example) points at -- the extension
# keeps its own independent auth session (it does not share the web app's login), but it
# is the same project and schema. Local stack: `supabase status -o env` in the repository
# root; the URL is API_URL and the key is PUBLISHABLE_KEY. Both values are browser-public.
WXT_SUPABASE_URL=
WXT_SUPABASE_PUBLISHABLE_KEY=

# The between-jobs FastAPI backend this extension calls. The local-development default is
# the API started with `--port 8012` (see ../README.md).
WXT_API_BASE_URL=http://localhost:8012
