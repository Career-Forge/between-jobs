        "profile": false,
        "model_key": false,
        "saved_searches": 0,
        "applications": {
          "count": 0,
          "from_discover": 0,
          "with_resume": 0
        }
      },
      "searched": null,
      "steps": {
        "profile": "todo",
        "model_key": "todo",
        "first_search": "unknown",
        "track_job": "todo",
        "generate_resume": "todo"
