{
  "about": "One table of accounts and the five first-run steps each must come out with, read by a test in Python (tests/test_first_run.py, against src/between_jobs/api/first_run.py) and one in TypeScript (web/src/lib/firstRunShared.test.ts, against web/src/lib/firstRun.ts). Written by hand from the rules, never computed from either implementation. A null fact is one that could not be read; 'searched' is the web app's browser-side memory of a first search (true, false, or null when it cannot be read: always null in a chat).",
  "step_order": [
    "profile",
    "model_key",
    "first_search",
    "track_job",
    "generate_resume"
  ],
  "labels": {
    "profile": "Add your profile",
    "model_key": "Add a model key",
    "first_search": "Run a first search",
    "track_job": "Track a job",
    "generate_resume": "Generate a resume"
  },
  "pages": {
    "profile": "/profile",
    "model_key": "/profile/integrations",
    "first_search": "/discover",
    "track_job": "/applications",
    "generate_resume": "/applications"
  },
  "cases": [
    {
      "name": "a brand-new account, browser remembers no search",
      "why": "Nothing is done, and every fact was read, so the first search is 'not yet', not unknown.",
      "facts": {
        "profile": false,
        "model_key": false,
        "saved_searches": 0,
        "applications": {
          "count": 0,
          "from_discover": 0,
          "with_resume": 0
        }
      },
      "searched": false,
      "steps": {
        "profile": "todo",
        "model_key": "todo",
        "first_search": "todo",
        "track_job": "todo",
        "generate_resume": "todo"
      },
      "done_count": 0,
      "next_step": "profile"
    },
    {
      "name": "a brand-new account as the chat sees it (it cannot see the browser)",
      "why": "The browser's memory of a search is unreadable from a chat, so with nothing else to go on the first search is unknown, never todo.",
