# Copy to .env.local and fill in for local development.
#
# Both values are BROWSER-PUBLIC by design (the publishable key is made to
# be embedded in client apps; RLS is what protects data) -- they're env
# vars for configurability across environments, not because they're
# secrets. Find them in the Supabase dashboard under Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
