# Copy to .env.local and fill in for local development.
#
# Both values are BROWSER-PUBLIC by design (the publishable key is made to
# be embedded in client apps; RLS is what protects data) -- they're env
# vars for configurability across environments, not because they're
# secrets. Find them in the Supabase dashboard under Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The API's origin. Leave UNSET for local development: requests go to /api and
# Vite's dev proxy (vite.config.ts) forwards them to the API on localhost:8012.
# REQUIRED for any `npm run build` -- a built bundle has no proxy, so the build
# refuses to run without an https:// origin that isn't local, e.g.
#   VITE_API_BASE_URL=https://api.example.com npm run build
# Pass it in the shell rather than here: a value in .env.local would otherwise
# leak into a bundle you meant to deploy.
# VITE_API_BASE_URL=https://api.example.com
